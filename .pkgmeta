package-as: Satellite

ignore:
  - .gitignore
  - .pkgmeta
  - .github
  # Generates the textures in Media; not needed in game.
  - tools
  # Planning notes for development.
  - ROADMAP.md
  # Test buttons and pins for development (its TOC line is between #@debug@ markers).
  - Debug
  # Logo sources for GitHub and CurseForge; only Media/Icon.tga is used in game.
  - Media/Emblem.svg
  - Media/Emblem.png
  - Media/Logo.svg
  - Media/Logo.png

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
